                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intencion }}",
                    "rightValue": "cupon",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "int-cupon"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CUPON"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intencion }}",
                    "rightValue": "encuesta",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "int-encuesta"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ENCUESTA"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intencion }}",
                    "rightValue": "borrar",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "int-borrar"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BORRAR"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
