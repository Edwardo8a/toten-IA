    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Normalizar entrada desde WAHA (NOWEB) — mismo patrón que el chatbot UTSJR ──\nlet payload;\nif ($json.payload && typeof $json.payload === 'object') {\n  payload = $json.payload;\n} else if ($json.body && typeof $json.body === 'object') {\n  payload = $json.body.payload || $json.body;\n} else {\n  payload = $json;\n}\n\nconst texto = (payload.body || payload.text || '').trim();\n\nconst chatIdRaw = payload.from || $json.from || '';\nconst chatId = chatIdRaw\n  .replace(/@lid$/, '@c.us')\n  .replace(/@s\\.whatsapp\\.net$/, '@c.us');\n\nconst numero = chatId.replace('@c.us', '').replace('@g.us', '');\nconst sessionId = 'totem_' + numero;\n\nconst sanitize = (t) => (t || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<[^>]+>/g, '')\n  .substring(0, 500);\n\nconst textoLimpio = sanitize(texto);\nconst nombreUsuario = payload.pushName || chatIdRaw.split('@')[0] || 'usuario';\n\nreturn {\n  json: {\n    texto: textoLimpio,\n    textoLower: textoLimpio.toLowerCase(),\n    chatId,\n    numero,\n    sessionId,\n    nombreUsuario,\n    timestamp: payload.timestamp || Date.now(),\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2176,
        -400
      ],
      "id": "15ffcecf-0ca8-4403-bc94-454764e38351",
      "name": "Normalizar WAHA",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Detecta la intención del mensaje entrante ──────────────────\nconst texto = $json.texto || '';\nconst textoLower = $json.textoLower || '';\n\nlet intencion = 'desconocido';\nlet interaccionId = null;\n\nif (/^cupon:/i.test(texto)) {\n  intencion = 'cupon';\n  interaccionId = texto.split(':')[1]?.trim() || null;\n} else if (textoLower === 'borrar mis datos') {\n  intencion = 'borrar';\n} else if (/^[1-4]$/.test(texto.trim())) {\n  intencion = 'encuesta';\n}\n\nreturn { json: { ...$json, intencion, interaccionId } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1952,
        -400
      ],
      "id": "6d12686a-474d-44d0-bec6-cd912933c3c4",
      "name": "Detectar Intención"
    },
