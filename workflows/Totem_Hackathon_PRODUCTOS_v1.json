          "id": "REEMPLAZAR_ID",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update productos set\n  nombre = coalesce($2, nombre),\n  categoria = coalesce($3, categoria),\n  descripcion = coalesce($4, descripcion),\n  precio = coalesce($5, precio),\n  costo = coalesce($6, costo),\n  etiquetas_demograficas = coalesce($7::jsonb, etiquetas_demograficas)\nwhere id = $1\nreturning *;",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.nombre, $json.categoria, $json.descripcion, $json.precio, $json.costo, $json.etiquetas_demograficas?.length ? JSON.stringify($json.etiquetas_demograficas) : null] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
