      ],
      "id": "30cce23f-f0e9-448e-b85c-e67c348fe07e",
      "name": "Switch — Operación"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into productos (nombre, categoria, descripcion, precio, costo, etiquetas_demograficas, loyverse_ref)\nvalues ($1, $2, $3, $4, $5, $6::jsonb, $7)\nreturning *;",
        "options": {
          "queryReplacement": "={{ [$json.nombre, $json.categoria, $json.descripcion, $json.precio, $json.costo, JSON.stringify($json.etiquetas_demograficas), $json.loyverse_ref] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -608,
        -80
      ],
      "id": "2fd7e924-7017-4efd-a956-def842288f91",
      "name": "Crear Producto",
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR_ID",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.loyverse.com/v1.0/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ item_name: $json.nombre, variants: [{ sku: $json.loyverse_ref, cost: $json.costo, default_price: $json.precio, default_pricing_type: 'FIXED' }] }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
