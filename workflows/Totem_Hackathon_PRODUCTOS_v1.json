          "id": "REEMPLAZAR_ID",
          "name": "Loyverse Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update productos set loyverse_variant_id = $1 where id = $2 returning *;",
        "options": {
          "queryReplacement": "={{ [$json.variants?.[0]?.variant_id || null, $('Crear Producto').item.json.id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
